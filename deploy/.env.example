# Copy to deploy/.env and fill in. NEVER commit the real file.
# Owner token: long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"). Prefer CIT_API_TOKEN_FILE with a Docker secret.
CIT_ENV=production
CIT_API_TOKEN=
CIT_DOMAIN=cit.example.com
CIT_LOG_LEVEL=WARNING
CIT_LOG_FORMAT=json
# Optional: local AI (Ollama on the same host / network)
CIT_OLLAMA_URL=http://host.docker.internal:11434
CIT_OLLAMA_MODELS=qwen3:8b,qwen2.5:7b,qwen3:4b,qwen2.5:1.5b
# Optional: email alerts. Without these, alert emails are recorded as "not_sent_no_smtp".
CIT_SMTP_HOST=
CIT_SMTP_PORT=587
CIT_SMTP_USER=
CIT_SMTP_PASSWORD=
CIT_SMTP_FROM=
